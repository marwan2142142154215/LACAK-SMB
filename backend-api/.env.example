APP_NAME="Lacak Master API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lacak_master
DB_USERNAME=lacak_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# DOCUMENTS_DISK: disk tujuan upload consent/foto/dokumen. Pakai 'spaces' setelah
# kredensial DigitalOcean Spaces diisi; sebelum itu fallback ke 'local' untuk dev.
DOCUMENTS_DISK=local
QUEUE_CONNECTION=database

# Standar 1.7: antrean transaksional wajib PostgreSQL (QUEUE_CONNECTION=database di atas).
# Redis hanya untuk cache & antrean non-transaksional (notifikasi, laporan, dsb).
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DigitalOcean Spaces (standar 6.3) - isi saat kredensial Anda tersedia.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=
DO_SPACES_URL=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_NAME=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_CONNECTOR_ID=

# Bot Telegram
TELEGRAM_BOT_TOKEN=

VITE_APP_NAME="${APP_NAME}"

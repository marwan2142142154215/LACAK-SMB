# Node
TZ=UTC
PORT=3333
# IPv4 eksplisit -- "localhost" bisa resolve ke ::1 (IPv6) di sebagian mesin,
# yang tidak bisa dicapai lewat `adb reverse` (device Android).
HOST=127.0.0.1
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (SAMA dengan backend-api Laravel)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=lacak_app
DB_PASSWORD=
DB_DATABASE=lacak_master

# Backend API (Laravel)
BACKEND_API_URL=http://127.0.0.1:8010

COMMAND_POLL_INTERVAL_MS=2000

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
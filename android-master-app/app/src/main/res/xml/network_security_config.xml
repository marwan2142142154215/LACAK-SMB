<?xml version="1.0" encoding="utf-8"?>
<!--
  Izin HTTP (cleartext) HANYA untuk alamat server lokal saat pengujian:
    - 127.0.0.1 / localhost : lewat `adb reverse tcp:3333 tcp:3333` (HP USB)
    - 10.0.2.2              : emulator Android -> host Windows

  Alamat publik (termasuk *.lacaksmbbot.com) TETAP wajib HTTPS — produksi
  lewat Cloudflare Tunnel selalu https, jadi tidak ada alasan melonggarkan
  aturan ini. Tanpa file ini Android 9+ menolak mentah-mentah koneksi
  http:// ke gateway ("CLEARTEXT communication not permitted") sehingga
  APK terlihat terpasang tapi tidak pernah tersambung.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>

# Salin jadi node.env di server LiveKit (B), isi semuanya, lalu:  sudo bash setup.sh node.env
# JANGAN di-commit (berisi alamat internal). Berkas ini tidak berisi secret.

# Alamat dashboard/backend (server A) dan alamat LiveKit (server B) -- tanpa https://
DOMAIN_APP=lacaklive.smbservice.xyz
DOMAIN_LIVE=live.smbservice.xyz
EMAIL_CERTBOT=

# IP server A: publik (untuk membatasi /twirp/ di nginx) dan privat/VPC (untuk firewall rekorder)
A_PUBLIC_IP=
A_PRIVATE_IP=
# IP privat/VPC server B ini (rekorder mendengar di sini)
B_PRIVATE_IP=

# IP kantor/rumah Anda: satu-satunya yang boleh SSH ke server ini (cek: curl -4 ifconfig.me dari laptop Anda)
ADMIN_IP=

# Versi LiveKit: harus sama dengan server A (di A: livekit-server --version), tanpa awalan v
LIVEKIT_VERSION=

# Berkas rekorder yang dibangun di A lalu disalin ke sini (lihat docs/pindah-livekit.md bagian 5)
RECORDER_BINARY=/root/lacak-recorder

# yes = matikan login root & password SSH. Hanya aktifkan SETELAH Anda berhasil login sebagai user "lacak" dengan kunci SSH.
HARDEN_SSH=no

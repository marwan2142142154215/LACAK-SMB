# Salin ke /etc/systemd/system/lacak-api-queue.service lalu:
#   sudo systemctl daemon-reload && sudo systemctl enable --now lacak-api-queue
# Menjalankan hasil build (node ace build) di /var/www/lacak/backend-adonis/build.
# User disamakan dengan pemilik folder & proses gateway (sesuaikan bila beda).
[Unit]
Description=Antrean build APK Lacak SMB (BullMQ)
After=network.target postgresql.service redis-server.service
# Jangan restart tanpa henti kalau error menetap (pelajaran dari lacak-bot).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=smbqa
WorkingDirectory=/var/www/lacak/backend-adonis/build
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node ace queue:work
Restart=on-failure
RestartSec=5
# Worker menunggu job yang sedang jalan selesai (build APK bisa sampai ~5 menit).
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target

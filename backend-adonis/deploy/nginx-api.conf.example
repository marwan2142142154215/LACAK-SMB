# Contoh potongan server block nginx untuk api.salahmu.fun selama peralihan
# Laravel -> AdonisJS (docs/rencana-migrasi-adonis.md, Tahap 5).
#
# Prinsip: satu kelompok path dipindah sekaligus; yang belum dipindah tetap ke
# Laravel (blok "location /" yang SUDAH ADA di server Anda, jangan dihapus).
# Membatalkan = hapus/komentari satu blok location lalu `sudo nginx -s reload`.
# Datanya tetap aman karena kedua backend memakai database yang sama.

upstream lacak_adonis {
    server 127.0.0.1:8020;   # PORT di backend-adonis/.env
    keepalive 16;
}

# Dipakai semua blok di bawah.
# proxy_set_header Host & X-Forwarded-* WAJIB: URL bertanda tangan (unduhan APK,
# dokumen, gambar chat) memakai LARAVEL_APP_URL, dan IP untuk rate limit/log.

# --- Langkah 1: Live Kerja & ringkasan dashboard (paling sering dipanggil) ---
location ~ ^/api/v1/(live/|dashboard-summary$) {
    proxy_pass http://lacak_adonis;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# --- Langkah 2: auth -- SEMUA /api/v1/auth/* SEKALIGUS ---

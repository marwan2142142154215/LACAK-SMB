TZ=UTC
PORT=8020
HOST=127.0.0.1
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
NODE_ENV=development

# Sama persis dengan APP_KEY & APP_URL di backend-api/.env
LARAVEL_APP_KEY=
LARAVEL_APP_URL=http://127.0.0.1:8010

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=lacak_app
DB_PASSWORD=
DB_DATABASE=lacak_master

# Sama dengan LIVEKIT_* di backend-api/.env
LIVEKIT_URL=wss://live.salahmu.fun
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=600

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Sama dengan backend-api/.env
APP_NAME="Lacak Master API"
SANCTUM_TOKEN_PREFIX=

# Opsional -- isi sama dengan backend-api/.env bila dipakai (lihat start/env.ts)
# ACCOUNTCENTER_ENABLED=false
# true = email Account Center yang belum terdaftar dibuatkan akun MENUNGGU AKTIVASI (nonaktif, tanpa peran/site)
# ACCOUNTCENTER_AUTO_PROVISION=false
# ACCOUNTCENTER_URI=
# ACCOUNTCENTER_NAME=
# ACCOUNTCENTER_SECRET=
# ACCOUNTCENTER_TIMEOUT_MS=10000
# Folder file lokal (disk "local"), path absolut DI LUAR folder build:
# STORAGE_PATH=/var/www/lacak/storage/app/private
# DOCUMENTS_DISK=spaces
# Produksi: SEMUA file ke Spaces, tidak ada yang disimpan di server.
# CHAT_IMAGES_DISK=spaces
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_REGION=sgp1
# DO_SPACES_BUCKET=
# DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
# Folder khusus proyek di dalam bucket (bawaan "lacaklive"): apk-builds/, chat/, recordings/
# DO_SPACES_PREFIX=lacaklive
# DO_SPACES_URL=
# Rekorder ringan tanpa Docker (folder recorder/): alamat lokalnya. Kosong = Egress resmi LiveKit.
# RECORDER_URL=http://127.0.0.1:7870
# Sumber yang direkam: camera, screen_share (pisah koma). Layar saja jauh lebih hemat penyimpanan.
# RECORDING_SOURCES=screen_share
# LACAKSMB_PUBLIC_GATEWAY_URL=
# LACAKSMB_PUBLIC_BACKEND_API_URL=
# Alamat dashboard web untuk menu chat/absensi/izin di APK Live.
# LACAKSMB_PUBLIC_DASHBOARD_URL=https://lacaklive.smbservice.xyz
# LACAKSMB_STATUS_GATEWAY_URL=
# LACAKSMB_STATUS_LIVEKIT_URL=
# LACAKSMB_STATUS_SYSTEMD_UNITS=lacak-adonis,lacak-adonis-worker,lacak-adonis-scheduler
# Server memakai pm2? Tampilkan proses pm2 di Status server (bukan unit systemd):
# LACAKSMB_STATUS_PROCESS_MANAGER=pm2
# LACAKSMB_STATUS_PM2_PROCESSES=lacak-api,lacak-api-queue,lacak-api-scheduler,lacak-gateway,lacak-bot
# LACAKSMB_TRACKER_PROJECT_PATH=
# LACAKSMB_MASTER_PROJECT_PATH=
# LACAKSMB_LIVE_PROJECT_PATH=
# LACAKSMB_SERVER_EXE_PATH=
# LACAKSMB_WSL_DISTRO=
# LIVE_HEARTBEAT_TIMEOUT_SECONDS=

# Zona waktu shift, jadwal briefing & laporan kerja
APP_TIMEZONE=Asia/Jakarta
# Peringatan & laporan kerja ke Telegram: sama dengan TELEGRAM_BOT_TOKEN di realtime-gateway/.env
TELEGRAM_BOT_TOKEN=

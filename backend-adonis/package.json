{
    "name": "backend-adonis",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "start": "node bin/server.js",
        "build": "node ace build",
        "dev": "node ace serve --hmr",
        "test": "node ace test",
        "lint": "eslint .",
        "format": "prettier --write .",
        "typecheck": "tsc --noEmit"
    },
    "imports": {
        "#controllers/*": "./app/controllers/*.js",
        "#exceptions/*": "./app/exceptions/*.js",
        "#models/*": "./app/models/*.js",
        "#services/*": "./app/services/*.js",
        "#middleware/*": "./app/middleware/*.js",
        "#validators/*": "./app/validators/*.js",
        "#jobs/*": "./app/jobs/*.js",
        "#providers/*": "./providers/*.js",
        "#database/*": "./database/*.js",
        "#tests/*": "./tests/*.js",
        "#start/*": "./start/*.js",
        "#config/*": "./config/*.js"
    },
    "devDependencies": {
        "@adonisjs/assembler": "^8.5.2",
        "@adonisjs/eslint-config": "^3.1.0",
        "@adonisjs/tsconfig": "^2.0.0",
        "@japa/api-client": "^3.2.1",
        "@japa/assert": "^4.2.0",
        "@japa/plugin-adonisjs": "^5.2.0",
        "@japa/runner": "^5.3.0",
        "@poppinss/ts-exec": "^1.4.4",
        "@types/luxon": "^3.7.5",
        "@types/node": "~26.6.2",
        "@types/pg": "^8.23.1",
        "@types/qrcode": "^1.5.6",
        "eslint": "^10.11.0",
        "hot-hook": "^1.0.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.9",
        "typescript": "~6.0.3",
        "youch": "^4.1.1"
    },
    "dependencies": {
        "@adonisjs/core": "^7.5.2",
        "@adonisjs/cors": "^3.0.0",
        "@adonisjs/lucid": "^22.4.2",
        "@adonisjs/redis": "^10.0.0",
        "@aws-sdk/client-s3": "^3.1156.0",
        "@aws-sdk/s3-request-presigner": "^3.1156.0",
        "@vinejs/vine": "^4.4.0",
        "bcryptjs": "^3.0.2",
        "bullmq": "^6.4.2",
        "luxon": "^3.7.2",
        "otplib": "^13.5.0",
        "pg": "^8.23.1",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2"
    },
    "hotHook": {
        "boundaries": [
            "./app/controllers/**/*.ts",
            "./app/middleware/*.ts"
        ]
    },
    "allowScripts": {
        "@swc/core": true,
        "esbuild": true,
        "fsevents": true
    },
    "prettier": {
        "trailingComma": "es5",
        "semi": false,
        "singleQuote": true,
        "useTabs": false,
        "tabWidth": 4,
        "quoteProps": "consistent",
        "bracketSpacing": true,
        "arrowParens": "always",
        "printWidth": 100
    }
}

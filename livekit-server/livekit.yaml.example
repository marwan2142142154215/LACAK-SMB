# Salin jadi livekit.yaml (JANGAN di-commit -- berisi secret, sudah di .gitignore).
port: 7880            # signaling WebSocket (lewat reverse proxy/Cloudflare -> wss://live.salahmu.fun)
rtc:
  tcp_port: 7881      # fallback media lewat TCP kalau UDP diblokir jaringan kantor
  # Media utama lewat UDP mux. Satu port = satu socket = satu core yang membaca
  # semua paket; rentang port >= jumlah vCPU membagi beban ke semua core
  # (rekomendasi LiveKit). 7882-7889 cukup sampai 8 vCPU. Buka semua port
  # UDP ini di firewall.
  udp_port: 7882-7889
  use_external_ip: true
  # Gabungkan penulisan paket keluar jadi lebih sedikit system call -- SFU
  # menghabiskan sebagian besar CPU-nya di sini. Tambahan jeda maks 2 ms.
  batch_io:
    batch_size: 128
    max_flush_interval: 2ms
keys:
  # <LIVEKIT_API_KEY>: <LIVEKIT_API_SECRET> -- harus sama dengan backend-api/.env
  # Secret minimal 32 karakter: openssl rand -base64 48
  GANTI_API_KEY: GANTI_SECRET_MINIMAL_32_KARAKTER
room:
  # Room site-* dibuat otomatis saat staf pertama masuk, dihapus 5 menit
  # setelah kosong.
  empty_timeout: 300
  max_participants: 0
logging:
  level: info
  pion_level: error

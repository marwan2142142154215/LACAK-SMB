{
    "name": "lacak-smb-desktop-agent",
    "version": "0.1.0",
    "private": true,
    "description": "Agen desktop Lacak SMB: pantau lokasi PC staf (GPS/WiFi, tahan-VPN) di latar belakang selama login.",
    "main": "src/main.js",
    "scripts": {
        "start": "electron .",
        "check": "node scripts/check-syntax.js",
        "dist": "electron-builder --win nsis"
    },
    "dependencies": {
        "socket.io-client": "4.8.1"
    },
    "devDependencies": {
        "electron": "33.2.1",
        "electron-builder": "25.1.8"
    },
    "build": {
        "appId": "xyz.smbservice.lacak.desktopagent",
        "productName": "Lacak SMB Agent",
        "files": ["src/**/*"],
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}

<?xml version="1.0" encoding="utf-8"?>
<!--
    Kebijakan Device Admin minimal untuk fondasi: hanya force-lock
    (DevicePolicyManager.lockNow()). Kemampuan lebih (wipe, batasan kamera,
    dsb.) TIDAK diminta di tahap fondasi ini — hanya ditambah kalau memang
    dipakai, sesuai prinsip minta izin seminimal mungkin.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>

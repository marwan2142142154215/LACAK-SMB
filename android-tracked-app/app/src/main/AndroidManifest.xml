<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Jaringan: komunikasi ke realtime-gateway (Socket.IO) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WiFi: baca SSID untuk aturan geofence "WiFi di luar whitelist" -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Lokasi: GPS akurat + estimasi jarak BLE (radar) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 10+ (API 29+): lokasi latar belakang wajib izin terpisah,
         diminta setelah izin foreground diberikan (lihat PermissionFlow.kt) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Bluetooth: anchor BLE untuk estimasi jarak -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android 12+ (API 31+): izin runtime baru untuk BLE scan. TIDAK pakai
         flag neverForLocation karena hasil scan BLE memang dipakai untuk
         mengestimasi jarak/posisi relatif (fitur radar) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 12+ (API 31+): izin runtime untuk BLE advertise — device ini
         memancarkan beacon berisi device_uuid-nya sendiri supaya APK master
         bisa mendeteksi jarak dekat (RSSI) saat mencari device secara fisik,
         terpisah dari GPS yang dipakai untuk posisi jarak jauh. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="31" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Foreground service: wajib selalu online memantau (standar permintaan) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notifikasi persisten yang jujur saat tracking aktif (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Auto-start service setelah reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Device Admin: kemampuan lock-screen jarak jauh (lockNow()). TIDAK
         dideklarasikan sebagai <uses-permission> di sini — BIND_DEVICE_ADMIN
         adalah permission level-sistem yang hanya boleh dipegang SISTEM saat
         memanggil receiver (lihat atribut android:permission di <receiver>
         TrackerDeviceAdminReceiver di bawah). App pihak ketiga tidak pernah
         "meminta" izin ini untuk dirinya sendiri. -->

    <!-- Supaya tracking tetap jalan walau device masuk Doze/App Standby -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Legacy: tidak lagi dipakai oleh layar kunci (LockActivity sekarang
         memakai startLockTask(), bukan lapisan overlay), tapi tetap diminta
         di langkah enrollment DISPLAY_OVER_OTHER_APPS sebagai jaring
         pengaman UI tambahan di perangkat yang tidak mengizinkan pinning. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".TrackerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.LacakTracker"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LacakTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TrackerForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Layar penuh wajib saat dikunci admin — screen pinning
             (startLockTask) di dalamnya menonaktifkan Home & Recents.
             excludeFromRecents + singleTask: tidak boleh ada cara swipe-away
             atau membuka instance kedua. -->
        <activity
            android:name=".ui.LockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LacakTracker" />

        <receiver
            android:name=".admin.TrackerDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- LockDefenseReceiver TIDAK didaftarkan di sini dengan sengaja:
             ACTION_SCREEN_ON dan ACTION_USER_PRESENT adalah broadcast
             implisit yang DIABAIKAN Android kalau didaftarkan lewat manifest
             sejak API 26 (pembatasan broadcast implisit) — registrasi di
             sini tidak akan pernah terpanggil sama sekali. Receiver ini
             didaftarkan secara DINAMIS di TrackerForegroundService.onCreate()
             (service selalu hidup, jadi selalu bisa mendaftar ulang). -->

    </application>

</manifest>
